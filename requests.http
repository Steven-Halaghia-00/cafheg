@baseUrl = http://localhost:8080/api

### Determine which parent has allocation rights
POST {{baseUrl}}/droits/quel-parent
Content-Type: application/json

{
  "enfantResidence": "Neuchatel",
  "enfantCantonDomicile": "NE",
  "parent1Residence": "Neuchatel",
  "parent2Residence": "Bienne",
  "parentsEnsemble": true,
  "parent1ActiviteLucrative": true,
  "parent1AutoriteParentale": true,
  "parent1CantonTravail": "BE",
  "parent1StatutProfessionnel": "SALARIE",
  "parent1RevenuAvs": 2500,
  "parent2ActiviteLucrative": true,
  "parent2AutoriteParentale": true,
  "parent2CantonTravail": "FR",
  "parent2StatutProfessionnel": "SALARIE",
  "parent2RevenuAvs": 3000
}

### List allocataires
GET {{baseUrl}}/allocataires

### Update allocataire name and firstname, noAVS in body must be ignored
PUT {{baseUrl}}/allocataires/1
Content-Type: application/json

{
  "nom": "Vuillaume",
  "prenom": "Theo",
  "noAVS": "9999-9999"
}

### Update allocataire without change should return 400
PUT {{baseUrl}}/allocataires/1
Content-Type: application/json

{
  "nom": "Vuillaume",
  "prenom": "Theo"
}

### Update unknown allocataire should return 404
PUT {{baseUrl}}/allocataires/99999
Content-Type: application/json

{
  "nom": "Vuillaume",
  "prenom": "Theo"
}

### Delete allocataire with versements should return 409
DELETE {{baseUrl}}/allocataires/1

### Delete allocataire without versements should return 204
DELETE {{baseUrl}}/allocataires/21

### Delete unknown allocataire should return 404
DELETE {{baseUrl}}/allocataires/99999
